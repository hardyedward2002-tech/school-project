let index=0, score=0, chosen=null, locked=false;
const qEl=document.getElementById('question'), answersEl=document.getElementById('answers'), feedbackEl=document.getElementById('feedback'), nextBtn=document.getElementById('next'), restartBtn=document.getElementById('restart');
function render(){chosen=null;locked=false;const q=questions[index];document.getElementById('questionCount').textContent=`Question ${index+1} of ${questions.length}`;document.getElementById('scoreLabel').textContent=`Score: ${score}`;document.getElementById('progressBar').style.width=`${(index+1)/questions.length*100}%`;qEl.textContent=q.q;answersEl.innerHTML='';feedbackEl.textContent='';nextBtn.disabled=true;nextBtn.textContent='Check answer';restartBtn.hidden=true;q.a.forEach((label,i)=>{const b=document.createElement('button');b.className='answer';b.type='button';b.setAttribute('aria-pressed','false');const letter=document.createElement('span');letter.className='letter';letter.textContent=String.fromCharCode(65+i);const txt=document.createElement('span');txt.textContent=label;b.append(letter,txt);b.addEventListener('click',()=>{if(locked)return;chosen=i;answersEl.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');nextBtn.disabled=false;});answersEl.appendChild(b);});}
function finish(){document.getElementById('questionCount').textContent='Quiz complete';document.getElementById('progressBar').style.width='100%';qEl.textContent='Nice work exploring how perception works.';answersEl.innerHTML='';feedbackEl.textContent='';nextBtn.hidden=true;restartBtn.hidden=false;const result=document.createElement('div');result.className='result';const strong=document.createElement('strong');strong.textContent=`${score}/${questions.length}`;const p=document.createElement('p');p.textContent=score===questions.length?'Perfect score. Keep questioning what you see.':score>=3?'Great job. You have the core ideas—explore the gallery again to reinforce them.':'Good start. Review the study guide and try again when you’re ready.';result.append(strong,p);answersEl.appendChild(result);}
nextBtn.addEventListener('click',()=>{if(locked&&nextBtn.textContent==='Next question →'){index++;if(index>=questions.length){finish();return;}render();return;}if(chosen===null||locked)return;locked=true;const q=questions[index];if(chosen===q.correct)score++;answersEl.querySelectorAll('button').forEach((b,i)=>{b.disabled=true;if(i===q.correct)b.style.borderColor='var(--accent)';if(i===chosen&&i!==q.correct)b.style.borderColor='#ff8b8b';});document.getElementById('scoreLabel').textContent=`Score: ${score}`;feedbackEl.textContent=(chosen===q.correct?'That’s right. ':'Not quite. ')+q.why;nextBtn.textContent='Next question →';});
restartBtn.addEventListener('click',()=>{index=0;score=0;nextBtn.hidden=false;render();});
render();
</script>
